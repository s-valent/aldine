# systemd service: one Aldine backup run. Pair with aldine-backup.timer.
# Install: copy both files to /etc/systemd/system/, edit WorkingDirectory + the
# backup destination, then: systemctl enable --now aldine-backup.timer
[Unit]
Description=Aldine volume backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# repo checkout that holds docker-compose.yml + deploy/
WorkingDirectory=/opt/aldine
# keep 14 daily snapshots under /var/backups/aldine
ExecStart=/bin/bash -lc 'mkdir -p /var/backups/aldine && deploy/backup.sh /var/backups/aldine/aldine-$(date +%%Y%%m%%d).tar.gz && ls -1t /var/backups/aldine/aldine-*.tar.gz | tail -n +15 | xargs -r rm -f'
